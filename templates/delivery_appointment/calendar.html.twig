<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Choisir ma date de livraison - Recyclum</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #f6f8fa 0%, #e9ecef 100%);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            min-height: 100vh;
        }
        .client-card {
            max-width: 800px;
            margin: 2rem auto;
            background: white;
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .client-card-header {
            background: linear-gradient(135deg, #16C669 0%, #12a356 100%);
            color: white;
            padding: 2rem;
            text-align: center;
        }
        .client-card-header h1 {
            font-size: 1.75rem;
            font-weight: 900;
            margin: 0 0 0.5rem 0;
        }
        .client-card-body {
            padding: 2rem;
        }
        .order-summary {
            background: linear-gradient(135deg, rgba(22, 198, 105, 0.1) 0%, rgba(22, 198, 105, 0.05) 100%);
            border: 2px solid rgba(22, 198, 105, 0.3);
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
        }
        .order-summary h3 {
            margin: 0 0 0.75rem 0;
            color: #16C669;
            font-size: 1rem;
            font-weight: 700;
        }
        .order-summary-items {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .order-summary-item {
            display: flex;
            justify-content: space-between;
            font-size: 0.875rem;
        }
        .order-summary-item .label {
            color: #6c7783;
        }
        .order-summary-item .value {
            font-weight: 600;
            color: #0f1418;
        }
        .info-box {
            background: #f8fafc;
            border-left: 4px solid #3b82f6;
            border-radius: 0 8px 8px 0;
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
        }
        .info-box ul {
            margin: 0;
            padding-left: 1.25rem;
            color: #4b5563;
            font-size: 0.875rem;
        }
        .info-box li {
            margin-bottom: 0.25rem;
        }
        .calendar-container {
            background: white;
            border: 2px solid #e6edf2;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }
        .calendar-header button {
            background: #16C669;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 0.5rem 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        .calendar-header button:hover:not(:disabled) {
            background: #12a356;
            transform: translateY(-2px);
        }
        .calendar-header button:disabled {
            background: #d1d5db;
            cursor: not-allowed;
        }
        .calendar-month-title {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 800;
            color: #0f1418;
        }
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.5rem;
        }
        .calendar-day-header {
            text-align: center;
            font-weight: 700;
            font-size: 0.75rem;
            color: #6c7783;
            padding: 0.5rem;
            text-transform: uppercase;
        }
        .calendar-day {
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #e6edf2;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            font-weight: 600;
            font-size: 0.9rem;
        }
        .calendar-day:hover:not(.disabled):not(.other-month):not(.weekend):not(.booked) {
            border-color: #16C669;
            background: rgba(22, 198, 105, 0.1);
        }
        .calendar-day.selected {
            background: #16C669;
            color: white;
            border-color: #16C669;
        }
        .calendar-day.disabled {
            background: #f8fafc;
            color: #d1d5db;
            cursor: not-allowed;
        }
        .calendar-day.past {
            background: #f1f5f9;
            color: #cbd5e1;
            cursor: not-allowed;
        }
        .calendar-day.other-month {
            color: #d1d5db;
            cursor: default;
        }
        .calendar-day.weekend {
            background: #fef2f2;
            color: #9ca3af;
            cursor: not-allowed;
        }
        .calendar-day.booked {
            background: #fef2f2;
            color: #ef4444;
            cursor: not-allowed;
            text-decoration: line-through;
        }
        .calendar-day.today {
            border-color: #3b82f6;
        }
        .confirmation-section {
            display: none;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(59, 130, 246, 0.05) 100%);
            border: 2px solid #3b82f6;
            border-radius: 12px;
            padding: 1.5rem;
            margin-top: 1.5rem;
        }
        .confirmation-section h3 {
            margin: 0 0 1rem 0;
            font-weight: 800;
            color: #1e40af;
            font-size: 1rem;
        }
        .selected-date-display {
            background: white;
            border-radius: 8px;
            padding: 1rem;
            text-align: center;
            margin-bottom: 1rem;
        }
        .selected-date-display .date {
            font-size: 1.25rem;
            font-weight: 800;
            color: #0f1418;
        }
        .btn-confirm {
            background: linear-gradient(135deg, #16C669 0%, #12a356 100%);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 1rem 2rem;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            width: 100%;
        }
        .btn-confirm:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(22, 198, 105, 0.3);
        }
        .btn-confirm:disabled {
            background: #d1d5db;
            cursor: not-allowed;
        }
        .legend {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 1rem;
            font-size: 0.75rem;
            color: #6c7783;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .legend-box {
            width: 16px;
            height: 16px;
            border-radius: 4px;
            border: 2px solid #e6edf2;
        }
        .legend-box.available {
            background: white;
            border-color: #16C669;
        }
        .legend-box.weekend {
            background: #fef2f2;
        }
        .legend-box.booked {
            background: #fef2f2;
            border-color: #ef4444;
        }
        .loading-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.9);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
        .loading-overlay.active {
            display: flex;
        }
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1050;
        }
        .toast-notification {
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            padding: 1rem 1.5rem;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            animation: slideIn 0.3s ease-out;
            max-width: 400px;
        }
        .toast-notification.error {
            border-left: 4px solid #ef4444;
        }
        .toast-notification.success {
            border-left: 4px solid #16C669;
        }
        .toast-notification .toast-icon {
            font-size: 1.25rem;
        }
        .toast-notification.error .toast-icon {
            color: #ef4444;
        }
        .toast-notification.success .toast-icon {
            color: #16C669;
        }
        .toast-notification .toast-message {
            flex: 1;
            font-size: 0.9rem;
            color: #1f2937;
            font-weight: 500;
        }
        .toast-notification .toast-close {
            background: none;
            border: none;
            color: #9ca3af;
            cursor: pointer;
            font-size: 1rem;
            padding: 0;
            transition: color 0.2s;
        }
        .toast-notification .toast-close:hover {
            color: #4b5563;
        }
        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        @keyframes slideOut {
            from {
                transform: translateX(0);
                opacity: 1;
            }
            to {
                transform: translateX(100%);
                opacity: 0;
            }
        }
        .spinner {
            width: 48px;
            height: 48px;
            border: 4px solid #e6edf2;
            border-top-color: #16C669;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        @media (max-width: 576px) {
            .client-card {
                margin: 1rem;
                border-radius: 12px;
            }
            .client-card-header {
                padding: 1.5rem;
            }
            .client-card-header h1 {
                font-size: 1.5rem;
            }
            .client-card-body {
                padding: 1.25rem;
            }
            .calendar-day {
                font-size: 0.8rem;
            }
        }
    </style>
</head>
<body>
<div class="loading-overlay" id="loading-overlay">
    <div class="spinner"></div>
    <p style="margin-top: 1rem; font-weight: 600; color: #6c7783;">Chargement...</p>
</div>

<div class="toast-container" id="toast-container"></div>

<div class="client-card">
    <div class="client-card-header">
        <h1><i class="fa fa-truck"></i> Choisir ma date de livraison</h1>
        <p style="margin: 0; opacity: 0.95;">Commande {{ order.orderNumber }}</p>
    </div>

    <div class="client-card-body"
         id="delivery-calendar"
         data-token="{{ token }}"
         data-available-dates="{{ availableDates }}"
         data-blocked-dates="{{ blockedDates }}"
         data-min-date="{{ minDate }}">

        {# Résumé de la commande #}
        <div class="order-summary">
            <h3><i class="fa fa-box"></i> Votre commande</h3>
            <div class="order-summary-items">
                {% for item in order.items %}
                <div class="order-summary-item">
                    <span class="label">{{ item.productTitle }}</span>
                    <span class="value">x{{ item.quantity }}</span>
                </div>
                {% endfor %}
                <div class="order-summary-item" style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid rgba(22, 198, 105, 0.2);">
                    <span class="label">Adresse de livraison</span>
                    <span class="value">{{ order.deliveryCity }} ({{ order.deliveryPostalCode }})</span>
                </div>
                <div class="order-summary-item">
                    <span class="label">Type de livraison</span>
                    <span class="value">
                        {% if order.deliveryType == 'with_installation' %}
                            Livraison + Installation
                        {% else %}
                            Livraison simple
                        {% endif %}
                    </span>
                </div>
            </div>
        </div>

        {# Informations #}
        <div class="info-box">
            <ul>
                <li>Sélectionnez une date disponible pour votre livraison</li>
                <li>Livraison effectuée entre 9h et 18h</li>
                <li>Vous serez contacté la veille pour confirmer le créneau</li>
                {% if order.deliveryType == 'with_installation' %}
                <li>Installation et mise en service incluses</li>
                {% endif %}
            </ul>
        </div>

        {# CALENDRIER #}
        <div class="calendar-container">
            <div class="calendar-header">
                <button id="prev-month" type="button">
                    <i class="fa fa-chevron-left"></i>
                </button>
                <h3 id="current-month-year" class="calendar-month-title"></h3>
                <button id="next-month" type="button">
                    <i class="fa fa-chevron-right"></i>
                </button>
            </div>

            <div class="calendar-grid">
                <div class="calendar-day-header">Lun</div>
                <div class="calendar-day-header">Mar</div>
                <div class="calendar-day-header">Mer</div>
                <div class="calendar-day-header">Jeu</div>
                <div class="calendar-day-header">Ven</div>
                <div class="calendar-day-header">Sam</div>
                <div class="calendar-day-header">Dim</div>
            </div>

            <div id="calendar-days" class="calendar-grid mt-2"></div>

            <div class="legend">
                <div class="legend-item">
                    <div class="legend-box available"></div>
                    <span>Disponible</span>
                </div>
                <div class="legend-item">
                    <div class="legend-box weekend"></div>
                    <span>Weekend (fermé)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-box booked"></div>
                    <span>Complet</span>
                </div>
            </div>
        </div>

        {# CONFIRMATION #}
        <div id="confirmation-section" class="confirmation-section">
            <h3><i class="fa fa-check-circle"></i> Confirmer votre date de livraison</h3>
            <div class="selected-date-display">
                <div class="date" id="selected-date-display">-</div>
            </div>
            <button id="btn-confirm" class="btn-confirm" type="button">
                <i class="fa fa-check"></i> Confirmer cette date
            </button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('delivery-calendar');
    const token = container.dataset.token;
    const minDateStr = container.dataset.minDate;
    let blockedDates = JSON.parse(container.dataset.blockedDates || '[]');

    const calendarDays = document.getElementById('calendar-days');
    const monthYearDisplay = document.getElementById('current-month-year');
    const prevBtn = document.getElementById('prev-month');
    const nextBtn = document.getElementById('next-month');
    const confirmSection = document.getElementById('confirmation-section');
    const selectedDateDisplay = document.getElementById('selected-date-display');
    const confirmBtn = document.getElementById('btn-confirm');
    const loadingOverlay = document.getElementById('loading-overlay');
    const toastContainer = document.getElementById('toast-container');

    // Toast notification function
    function showToast(message, type = 'error') {
        const toast = document.createElement('div');
        toast.className = `toast-notification ${type}`;
        toast.innerHTML = `
            <span class="toast-icon">
                <i class="fa ${type === 'error' ? 'fa-exclamation-circle' : 'fa-check-circle'}"></i>
            </span>
            <span class="toast-message">${message}</span>
            <button class="toast-close" type="button">
                <i class="fa fa-times"></i>
            </button>
        `;

        toastContainer.appendChild(toast);

        const closeBtn = toast.querySelector('.toast-close');
        closeBtn.addEventListener('click', () => removeToast(toast));

        // Auto-remove after 5 seconds
        setTimeout(() => removeToast(toast), 5000);
    }

    function removeToast(toast) {
        toast.style.animation = 'slideOut 0.3s ease-out forwards';
        setTimeout(() => toast.remove(), 300);
    }

    const months = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
    const daysShort = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];

    let currentDate = new Date();
    let currentMonth = currentDate.getMonth();
    let currentYear = currentDate.getFullYear();
    let selectedDate = null;

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // Parse minDate properly to avoid timezone issues
    const [minYear, minMonth, minDay] = minDateStr.split('-').map(Number);
    const minDate = new Date(minYear, minMonth - 1, minDay);
    minDate.setHours(0, 0, 0, 0);

    const maxDate = new Date();
    maxDate.setHours(0, 0, 0, 0);
    maxDate.setDate(maxDate.getDate() + 30);


    function formatDate(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function formatDateFrench(date) {
        const dayName = daysShort[date.getDay()];
        const day = date.getDate();
        const month = months[date.getMonth()];
        const year = date.getFullYear();
        return `${dayName} ${day} ${month} ${year}`;
    }

    function isWeekend(date) {
        const day = date.getDay();
        return day === 0 || day === 6;
    }

    function isBooked(dateStr) {
        return blockedDates.includes(dateStr);
    }

    function isBeforeMin(date) {
        return date < minDate;
    }

    function isAfterMax(date) {
        return date > maxDate;
    }

    function renderCalendar() {
        calendarDays.innerHTML = '';
        monthYearDisplay.textContent = `${months[currentMonth]} ${currentYear}`;

        // Disable prev button if we're at current month
        const nowMonth = new Date().getMonth();
        const nowYear = new Date().getFullYear();
        prevBtn.disabled = (currentYear === nowYear && currentMonth === nowMonth);

        // Disable next button if we're at max month
        const maxMonth = maxDate.getMonth();
        const maxYear = maxDate.getFullYear();
        nextBtn.disabled = (currentYear === maxYear && currentMonth === maxMonth);

        const firstDay = new Date(currentYear, currentMonth, 1);
        const lastDay = new Date(currentYear, currentMonth + 1, 0);

        // Get Monday as first day (0 = Monday in our display)
        let startDay = firstDay.getDay() - 1;
        if (startDay < 0) startDay = 6;

        // Previous month days
        const prevMonthLastDay = new Date(currentYear, currentMonth, 0).getDate();
        for (let i = startDay - 1; i >= 0; i--) {
            const dayEl = document.createElement('div');
            dayEl.className = 'calendar-day other-month';
            dayEl.textContent = prevMonthLastDay - i;
            calendarDays.appendChild(dayEl);
        }

        // Current month days
        for (let day = 1; day <= lastDay.getDate(); day++) {
            const date = new Date(currentYear, currentMonth, day);
            date.setHours(0, 0, 0, 0); // Normalize to midnight for comparison
            const dateStr = formatDate(date);
            const dayEl = document.createElement('div');
            dayEl.className = 'calendar-day';
            dayEl.textContent = day;
            dayEl.dataset.date = dateStr;

            // Mark today
            if (date.getTime() === today.getTime()) {
                dayEl.classList.add('today');
            }

            // Check if date is selectable
            const isPast = date.getTime() < minDate.getTime();
            const isFuture = date.getTime() > maxDate.getTime();
            const isWeekendDay = isWeekend(date);
            const isBookedDay = isBooked(dateStr);

            if (isPast) {
                // Dates before minimum allowed date
                dayEl.classList.add('past');
            } else if (isFuture) {
                // Dates too far in the future
                dayEl.classList.add('disabled');
            } else if (isWeekendDay) {
                dayEl.classList.add('weekend');
            } else if (isBookedDay) {
                dayEl.classList.add('booked');
            } else {
                // Date is available - add click handler
                dayEl.addEventListener('click', function() {
                    selectDate(date, dateStr, this);
                });
            }

            if (selectedDate && dateStr === formatDate(selectedDate)) {
                dayEl.classList.add('selected');
            }

            calendarDays.appendChild(dayEl);
        }

        // Next month days
        const totalCells = startDay + lastDay.getDate();
        const remainingCells = 7 - (totalCells % 7);
        if (remainingCells < 7) {
            for (let i = 1; i <= remainingCells; i++) {
                const dayEl = document.createElement('div');
                dayEl.className = 'calendar-day other-month';
                dayEl.textContent = i;
                calendarDays.appendChild(dayEl);
            }
        }
    }

    function selectDate(date, dateStr, element) {
        // Remove previous selection
        document.querySelectorAll('.calendar-day.selected').forEach(el => {
            el.classList.remove('selected');
        });

        selectedDate = date;
        element.classList.add('selected');

        // Show confirmation section
        confirmSection.style.display = 'block';
        selectedDateDisplay.textContent = formatDateFrench(date);
    }

    async function fetchBlockedDates(year, month) {
        try {
            const response = await fetch(`/livraison/rdv/${token}/blocked-dates?year=${year}&month=${month}`);
            const data = await response.json();
            if (data.success) {
                blockedDates = [...new Set([...blockedDates, ...data.blocked_dates])];
            }
        } catch (error) {
            console.error('Error fetching blocked dates:', error);
        }
    }

    prevBtn.addEventListener('click', async function() {
        currentMonth--;
        if (currentMonth < 0) {
            currentMonth = 11;
            currentYear--;
        }
        await fetchBlockedDates(currentYear, currentMonth + 1);
        renderCalendar();
    });

    nextBtn.addEventListener('click', async function() {
        currentMonth++;
        if (currentMonth > 11) {
            currentMonth = 0;
            currentYear++;
        }
        await fetchBlockedDates(currentYear, currentMonth + 1);
        renderCalendar();
    });

    confirmBtn.addEventListener('click', async function() {
        if (!selectedDate) return;

        confirmBtn.disabled = true;
        loadingOverlay.classList.add('active');

        try {
            const response = await fetch(`/livraison/rdv/${token}/confirm`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    date: formatDate(selectedDate)
                })
            });

            const data = await response.json();

            if (data.success) {
                window.location.href = `/livraison/rdv/${token}/confirmation`;
            } else {
                showToast(data.error || 'Une erreur est survenue', 'error');
                confirmBtn.disabled = false;
                loadingOverlay.classList.remove('active');
            }
        } catch (error) {
            console.error('Error:', error);
            showToast('Une erreur est survenue. Veuillez réessayer.', 'error');
            confirmBtn.disabled = false;
            loadingOverlay.classList.remove('active');
        }
    });

    // Initial render
    renderCalendar();
});
</script>
</body>
</html>
