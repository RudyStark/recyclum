{% extends 'base.html.twig' %}

{% block title %}Créer un compte | Recyclum{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            {# Logo #}
            <div class="auth-logo">
                <a href="{{ path('app_home') }}">
                    <div class="auth-logo-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M12 6v6l4 2"></path>
                            <path d="M16 12l-4-2-4 2"></path>
                        </svg>
                    </div>
                    <span class="auth-logo-text">Recyclum</span>
                </a>
            </div>

            {# Title #}
            <div class="auth-header">
                <h1 class="auth-title">Créer un compte</h1>
                <p class="auth-subtitle">Rejoignez-nous pour accéder à votre espace personnel</p>
            </div>

            {# Flash Messages #}
            {% for message in app.flashes('error') %}
                <div class="auth-alert auth-alert-danger">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                    {{ message }}
                </div>
            {% endfor %}

            {# Registration Form #}
            {{ form_start(registrationForm, {'attr': {'class': 'auth-form', 'novalidate': 'novalidate'}}) }}

                {# Name Fields Row #}
                <div class="auth-form-row">
                    <div class="auth-form-group">
                        {{ form_label(registrationForm.firstName, null, {'label_attr': {'class': 'auth-label'}}) }}
                        {{ form_widget(registrationForm.firstName, {'attr': {'class': 'auth-input' ~ (registrationForm.firstName.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(registrationForm.firstName) }}
                    </div>
                    <div class="auth-form-group">
                        {{ form_label(registrationForm.lastName, null, {'label_attr': {'class': 'auth-label'}}) }}
                        {{ form_widget(registrationForm.lastName, {'attr': {'class': 'auth-input' ~ (registrationForm.lastName.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(registrationForm.lastName) }}
                    </div>
                </div>

                {# Email #}
                <div class="auth-form-group">
                    {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'auth-label'}}) }}
                    <div class="auth-input-icon-wrapper">
                        <svg class="auth-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        {{ form_widget(registrationForm.email, {'attr': {'class': 'auth-input auth-input-with-icon' ~ (registrationForm.email.vars.errors|length ? ' is-invalid' : '')}}) }}
                    </div>
                    {{ form_errors(registrationForm.email) }}
                </div>

                {# Phone #}
                <div class="auth-form-group">
                    {{ form_label(registrationForm.phone, null, {'label_attr': {'class': 'auth-label'}}) }}
                    <div class="auth-input-icon-wrapper">
                        <svg class="auth-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        {{ form_widget(registrationForm.phone, {'attr': {'class': 'auth-input auth-input-with-icon' ~ (registrationForm.phone.vars.errors|length ? ' is-invalid' : '')}}) }}
                    </div>
                    {{ form_errors(registrationForm.phone) }}
                </div>

                {# Password #}
                <div class="auth-form-group">
                    {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': 'auth-label'}}) }}
                    <div class="auth-input-icon-wrapper">
                        <svg class="auth-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'auth-input auth-input-with-icon' ~ (registrationForm.plainPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                    </div>
                    <p class="auth-hint">Minimum 8 caractères avec au moins 1 chiffre</p>
                    {{ form_errors(registrationForm.plainPassword.first) }}
                </div>

                {# Confirm Password #}
                <div class="auth-form-group">
                    {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': 'auth-label'}}) }}
                    <div class="auth-input-icon-wrapper">
                        <svg class="auth-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'auth-input auth-input-with-icon' ~ (registrationForm.plainPassword.second.vars.errors|length ? ' is-invalid' : '')}}) }}
                    </div>
                    {{ form_errors(registrationForm.plainPassword.second) }}
                </div>

                {# Terms Checkbox #}
                <div class="auth-form-group auth-checkbox-group">
                    <label class="auth-checkbox">
                        {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'auth-checkbox-input'}}) }}
                        <span class="auth-checkbox-mark"></span>
                        <span class="auth-checkbox-label">{{ registrationForm.agreeTerms.vars.label|raw }}</span>
                    </label>
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>

                {# Submit Button #}
                <button type="submit" class="auth-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <line x1="20" y1="8" x2="20" y2="14"></line>
                        <line x1="23" y1="11" x2="17" y2="11"></line>
                    </svg>
                    Créer mon compte
                </button>

            {{ form_end(registrationForm) }}

            {# Divider #}
            <div class="auth-divider">
                <span>ou</span>
            </div>

            {# Footer Links #}
            <div class="auth-footer">
                <p>Vous avez déjà un compte ?</p>
                <a href="{{ path('app_login') }}" class="auth-link">
                    Se connecter
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>
        </div>

        {# Benefits Section #}
        <div class="auth-benefits">
            <h3>Pourquoi créer un compte ?</h3>
            <ul class="auth-benefits-list">
                <li>
                    <div class="auth-benefit-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <div>
                        <strong>Suivi de commandes</strong>
                        <span>Consultez l'historique et le statut de vos commandes</span>
                    </div>
                </li>
                <li>
                    <div class="auth-benefit-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <div>
                        <strong>Adresses sauvegardées</strong>
                        <span>Passez commande plus rapidement</span>
                    </div>
                </li>
                <li>
                    <div class="auth-benefit-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </div>
                    <div>
                        <strong>Garantie simplifiée</strong>
                        <span>Accédez à vos factures et garanties facilement</span>
                    </div>
                </li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}
