{% extends 'checkout/_layout.html.twig' %}

{% block title %}Livraison | Recyclum{% endblock %}

{% block head %}
    {{ parent() }}
    <meta name="csrf-token-checkout_delivery" content="{{ csrf_token('checkout_delivery') }}">
{% endblock %}

{% block checkout_content %}
    <div class="container">
        <div class="checkout-grid">
            {# Formulaire #}
            <div class="checkout-main">
                <form method="post" class="checkout-form-sections">

                    {# === SECTION 1 : CONTACT === #}
                    {% if isGuest %}
                        <div class="checkout-section">
                            <div class="checkout-section-header">
                                <div class="checkout-section-number">1</div>
                                <div class="checkout-section-title">
                                    <h3>Contact</h3>
                                    <p>Pour la confirmation de commande</p>
                                </div>
                            </div>
                            <div class="checkout-section-body">
                                <div class="form-group">
                                    <label for="email">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                            <polyline points="22,6 12,13 2,6"></polyline>
                                        </svg>
                                        Adresse email *
                                    </label>
                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        class="form-control {{ errors.email is defined ? 'is-invalid' : '' }}"
                                        value="{{ deliveryData.email }}"
                                        placeholder="votre@email.com"
                                        required
                                    >
                                    {% if errors.email is defined %}
                                        <div class="invalid-feedback">{{ errors.email }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {# === SECTION 2 : IDENTITÉ === #}
                    <div class="checkout-section">
                        <div class="checkout-section-header">
                            <div class="checkout-section-number">{{ isGuest ? '2' : '1' }}</div>
                            <div class="checkout-section-title">
                                <h3>Identité du destinataire</h3>
                                <p>Nom et prénom de la personne qui recevra la livraison</p>
                            </div>
                        </div>
                        <div class="checkout-section-body">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="firstName">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="12" cy="7" r="4"></circle>
                                        </svg>
                                        Prénom *
                                    </label>
                                    <input
                                        type="text"
                                        id="firstName"
                                        name="firstName"
                                        class="form-control {{ errors.firstName is defined ? 'is-invalid' : '' }}"
                                        value="{{ deliveryData.firstName }}"
                                        placeholder="Jean"
                                        required
                                    >
                                    {% if errors.firstName is defined %}
                                        <div class="invalid-feedback">{{ errors.firstName }}</div>
                                    {% endif %}
                                </div>

                                <div class="form-group">
                                    <label for="lastName">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="12" cy="7" r="4"></circle>
                                        </svg>
                                        Nom *
                                    </label>
                                    <input
                                        type="text"
                                        id="lastName"
                                        name="lastName"
                                        class="form-control {{ errors.lastName is defined ? 'is-invalid' : '' }}"
                                        value="{{ deliveryData.lastName }}"
                                        placeholder="Dupont"
                                        required
                                    >
                                    {% if errors.lastName is defined %}
                                        <div class="invalid-feedback">{{ errors.lastName }}</div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="phone">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                    </svg>
                                    Téléphone mobile *
                                </label>
                                <input
                                    type="tel"
                                    id="phone"
                                    name="phone"
                                    class="form-control {{ errors.phone is defined ? 'is-invalid' : '' }}"
                                    value="{{ deliveryData.phone }}"
                                    placeholder="0612345678"
                                    pattern="[0-9]{10}"
                                    maxlength="10"
                                    required
                                >
                                {% if errors.phone is defined %}
                                    <div class="invalid-feedback">{{ errors.phone }}</div>
                                {% else %}
                                    <small class="form-help">Pour vous contacter le jour de la livraison</small>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {# === SECTION 3 : ADRESSE === #}
                    <div class="checkout-section">
                        <div class="checkout-section-header">
                            <div class="checkout-section-number">{{ isGuest ? '3' : '2' }}</div>
                            <div class="checkout-section-title">
                                <h3>Adresse de livraison</h3>
                                <p>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    Livraison uniquement en Île-de-France
                                </p>
                            </div>
                        </div>
                        <div class="checkout-section-body">
                            <div class="form-group">
                                <label for="street">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                    </svg>
                                    Adresse *
                                </label>
                                <input
                                    type="text"
                                    id="street"
                                    name="street"
                                    class="form-control {{ errors.street is defined ? 'is-invalid' : '' }}"
                                    value="{{ deliveryData.street }}"
                                    placeholder="15 Rue de la République"
                                    required
                                >
                                {% if errors.street is defined %}
                                    <div class="invalid-feedback">{{ errors.street }}</div>
                                {% endif %}
                            </div>

                            <div class="form-group">
                                <label for="streetComplement">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                        <path d="M9 3v18"></path>
                                    </svg>
                                    Complément d'adresse <span class="optional">(Optionnel)</span>
                                </label>
                                <input
                                    type="text"
                                    id="streetComplement"
                                    name="streetComplement"
                                    class="form-control"
                                    value="{{ deliveryData.streetComplement }}"
                                    placeholder="Bât. A, Étage 3, Appt. 12"
                                >
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="postalCode">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                            <circle cx="12" cy="10" r="3"></circle>
                                        </svg>
                                        Code postal *
                                    </label>
                                    <input
                                        type="text"
                                        id="postalCode"
                                        name="postalCode"
                                        class="form-control {{ errors.postalCode is defined ? 'is-invalid' : '' }}"
                                        value="{{ deliveryData.postalCode }}"
                                        placeholder="75001"
                                        pattern="[0-9]{5}"
                                        maxlength="5"
                                        required
                                    >
                                    {% if errors.postalCode is defined %}
                                        <div class="invalid-feedback">{{ errors.postalCode }}</div>
                                    {% endif %}
                                </div>

                                <div class="form-group">
                                    <label for="city">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                        </svg>
                                        Ville *
                                    </label>
                                    <input
                                        type="text"
                                        id="city"
                                        name="city"
                                        class="form-control {{ errors.city is defined ? 'is-invalid' : '' }}"
                                        value="{{ deliveryData.city }}"
                                        placeholder="Paris"
                                        required
                                    >
                                    {% if errors.city is defined %}
                                        <div class="invalid-feedback">{{ errors.city }}</div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="instructions">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                        <line x1="16" y1="13" x2="8" y2="13"></line>
                                        <line x1="16" y1="17" x2="8" y2="17"></line>
                                        <polyline points="10 9 9 9 8 9"></polyline>
                                    </svg>
                                    Instructions de livraison <span class="optional">(Optionnel)</span>
                                </label>
                                <textarea
                                    id="instructions"
                                    name="instructions"
                                    class="form-control"
                                    rows="3"
                                    placeholder="Code d'accès : A1234, Sonner chez le gardien..."
                                >{{ deliveryData.instructions }}</textarea>
                                <small class="form-help">Informations utiles pour le livreur (digicode, étage, etc.)</small>
                            </div>
                        </div>
                    </div>

                    {# === SECTION 4 : TYPE DE LIVRAISON === #}
                    <div class="checkout-section">
                        <div class="checkout-section-header">
                            <div class="checkout-section-number">{{ isGuest ? '4' : '3' }}</div>
                            <div class="checkout-section-title">
                                <h3>Type de livraison</h3>
                                <p>Choisissez le service adapté à vos besoins</p>
                            </div>
                        </div>
                        <div class="checkout-section-body">
                            <div class="delivery-options-pro">
                                <label class="delivery-option-pro">
                                    <input
                                        type="radio"
                                        name="deliveryType"
                                        value="simple"
                                        {{ deliveryData.deliveryType == 'simple' ? 'checked' : '' }}
                                        required
                                    >
                                    <div class="delivery-option-pro-content">
                                        <div class="delivery-option-pro-header">
                                            <div class="delivery-option-pro-icon">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="1" y="3" width="15" height="13"></rect>
                                                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                                </svg>
                                            </div>
                                            <div class="delivery-option-pro-info">
                                                <span class="delivery-option-pro-label">Livraison simple</span>
                                                <span class="delivery-option-pro-desc">Livraison devant votre domicile</span>
                                            </div>
                                            <div class="delivery-option-pro-price">20€</div>
                                        </div>
                                        <ul class="delivery-option-pro-features">
                                            <li>
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                Livraison en bas de chez vous
                                            </li>
                                            <li>
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                2 à 5 jours ouvrés
                                            </li>
                                        </ul>
                                    </div>
                                </label>

                                <label class="delivery-option-pro delivery-option-pro-premium">
                                    <div class="delivery-option-pro-badge">Recommandé</div>
                                    <input
                                        type="radio"
                                        name="deliveryType"
                                        value="with_installation"
                                        {{ deliveryData.deliveryType == 'with_installation' ? 'checked' : '' }}
                                    >
                                    <div class="delivery-option-pro-content">
                                        <div class="delivery-option-pro-header">
                                            <div class="delivery-option-pro-icon">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M20 7h-9"></path>
                                                    <path d="M14 17H5"></path>
                                                    <circle cx="17" cy="17" r="3"></circle>
                                                    <circle cx="7" cy="7" r="3"></circle>
                                                </svg>
                                            </div>
                                            <div class="delivery-option-pro-info">
                                                <span class="delivery-option-pro-label">Livraison + Installation</span>
                                                <span class="delivery-option-pro-desc">Installation et mise en service complète</span>
                                            </div>
                                            <div class="delivery-option-pro-price">30€</div>
                                        </div>
                                        <ul class="delivery-option-pro-features">
                                            <li>
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                Déballage et installation
                                            </li>
                                            <li>
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                Mise en service et test
                                            </li>
                                            <li>
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                Reprise de l'ancien appareil
                                            </li>
                                        </ul>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    {# === ACTIONS === #}
                    <div class="checkout-form-actions">
                        <a href="{{ path('cart_index') }}" class="btn btn-outline-secondary btn-lg">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            Retour au panier
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg">
                            Continuer vers le récapitulatif
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </button>
                    </div>
                </form>
            </div>

            {# Sidebar récapitulatif #}
            <div class="checkout-sidebar">
                {% include 'checkout/_cart_summary.html.twig' %}
            </div>
        </div>
    </div>
{% endblock %}
