{% extends 'base.html.twig' %}

{% block title %}Commande confirmée | Recyclum{% endblock %}

{% block body %}
    <div class="confirmation-page">
        <div class="container">
            <div class="confirmation-content">
                {# Icône de succès #}
                <div class="confirmation-icon">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>

                {# Titre #}
                <h1>Commande confirmée !</h1>
                <p class="confirmation-subtitle">
                    Merci pour votre confiance. Nous avons bien reçu votre paiement.
                </p>

                {# Informations commande #}
                <div class="confirmation-order-info">
                    <div class="confirmation-order-card">
                        <div class="confirmation-order-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                        </div>
                        <span class="confirmation-order-label">Numéro de commande</span>
                        <strong class="confirmation-order-value">{{ order.orderNumber }}</strong>
                    </div>

                    <div class="confirmation-order-card">
                        <div class="confirmation-order-icon confirmation-order-icon-green">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="1" x2="12" y2="23"></line>
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                        </div>
                        <span class="confirmation-order-label">Montant payé</span>
                        <strong class="confirmation-order-value confirmation-order-value-green">{{ order.totalFormatted }}</strong>
                    </div>
                </div>

                {# Email de confirmation #}
                {% if order.user %}
                    {% set email = order.user.email %}
                {% else %}
                    {% set email = order.deliveryFirstName ~ ' ' ~ order.deliveryLastName %}
                {% endif %}

                <div class="confirmation-email-notice">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    <div>
                        <strong>Un email de confirmation vous a été envoyé</strong>
                        <p>Vous recevrez toutes les informations concernant votre commande par email.</p>
                    </div>
                </div>

                {# Lien de suivi pour invités #}
                {% if not order.user and order.trackingToken %}
                    <div class="confirmation-tracking-link">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                        </svg>
                        <div>
                            <strong>Lien de suivi de votre commande</strong>
                            <p>Conservez ce lien pour suivre votre commande sans créer de compte :</p>
                            <a href="{{ url('order_tracking', {orderNumber: order.orderNumber, token: order.trackingToken}) }}" class="tracking-link-url" target="_blank">
                                {{ url('order_tracking', {orderNumber: order.orderNumber, token: order.trackingToken}) }}
                            </a>
                        </div>
                    </div>
                {% endif %}

                {# Prochaines étapes #}
                <div class="confirmation-steps">
                    <h2>Et maintenant ?</h2>

                    <div class="confirmation-steps-list">
                        <div class="confirmation-step">
                            <div class="confirmation-step-number">1</div>
                            <div class="confirmation-step-content">
                                <strong>Confirmation de commande</strong>
                                <p>Un email récapitulatif vient de vous être envoyé avec tous les détails de votre commande.</p>
                            </div>
                        </div>

                        <div class="confirmation-step">
                            <div class="confirmation-step-number">2</div>
                            <div class="confirmation-step-content">
                                <strong>Préparation de votre commande</strong>
                                <p>Votre commande sera préparée dans les <strong>24 à 48 heures</strong>. Vous recevrez un email dès qu'elle sera expédiée.</p>
                            </div>
                        </div>

                        <div class="confirmation-step">
                            <div class="confirmation-step-number">3</div>
                            <div class="confirmation-step-content">
                                <strong>Livraison par nos équipes</strong>
                                <p>Nos livreurs vous contacteront pour convenir d'un créneau de livraison.
                                    {% if order.deliveryType == 'with_installation' %}
                                        <strong>Installation et mise en service incluses.</strong>
                                    {% else %}
                                        Livraison en bas de chez vous.
                                    {% endif %}
                                </p>
                            </div>
                        </div>

                        <div class="confirmation-step">
                            <div class="confirmation-step-number">4</div>
                            <div class="confirmation-step-content">
                                <strong>Réception et satisfaction</strong>
                                <p>Profitez de votre appareil reconditionné avec notre garantie jusqu'à 24 mois !</p>
                            </div>
                        </div>
                    </div>
                </div>

                {# Récapitulatif produits #}
                <div class="confirmation-products">
                    <h3>Récapitulatif de votre commande</h3>
                    <div class="confirmation-products-list">
                        {% for item in order.items %}
                            <div class="confirmation-product-item">
                                <div class="confirmation-product-info">
                                    <strong>{{ item.productTitle }}</strong>
                                    <span>{{ item.productBrand }} · {{ item.productCategory }}</span>
                                </div>
                                <div class="confirmation-product-qty">× {{ item.quantity }}</div>
                                <div class="confirmation-product-price">{{ item.subtotalFormatted }}</div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="confirmation-products-total">
                        <div class="confirmation-total-line">
                            <span>Sous-total</span>
                            <span>{{ order.subtotalFormatted }}</span>
                        </div>
                        <div class="confirmation-total-line">
                            <span>Livraison</span>
                            <span>{{ order.deliveryPriceFormatted }}</span>
                        </div>
                        <div class="confirmation-total-line confirmation-total-line-final">
                            <span>Total TTC</span>
                            <strong>{{ order.totalFormatted }}</strong>
                        </div>
                    </div>
                </div>

                {# Adresse de livraison #}
                <div class="confirmation-delivery">
                    <h3>Adresse de livraison</h3>
                    <div class="confirmation-delivery-address">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <div>
                            <strong>{{ order.deliveryFirstName }} {{ order.deliveryLastName }}</strong>
                            <p>
                                {{ order.deliveryStreet }}<br>
                                {% if order.deliveryStreetComplement %}
                                    {{ order.deliveryStreetComplement }}<br>
                                {% endif %}
                                {{ order.deliveryPostalCode }} {{ order.deliveryCity }}
                            </p>
                            <p><strong>Tél :</strong> {{ order.deliveryPhone }}</p>
                        </div>
                    </div>
                </div>

                {# Actions #}
                <div class="confirmation-actions">
                    {% if order.user %}
                        <a href="{{ path('app_home') }}" class="btn btn-primary btn-lg">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                            Retour à l'accueil
                        </a>
                        <a href="{{ path('account_order_show', {orderNumber: order.orderNumber}) }}" class="btn btn-outline-primary btn-lg">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="3" width="15" height="13"></rect>
                                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                <circle cx="18.5" cy="18.5" r="2.5"></circle>
                            </svg>
                            Voir ma commande
                        </a>
                    {% else %}
                        <a href="{{ path('app_home') }}" class="btn btn-primary btn-lg">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                            Retour à l'accueil
                        </a>
                        {% if order.trackingToken %}
                            <a href="{{ url('order_tracking', {orderNumber: order.orderNumber, token: order.trackingToken}) }}" class="btn btn-outline-primary btn-lg">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                Suivre ma commande
                            </a>
                        {% endif %}
                    {% endif %}
                </div>

                {# Besoin d'aide #}
                <div class="confirmation-help">
                    <p>Une question concernant votre commande ?</p>
                    <a href="#">( A FAIRE ) Contactez notre service client</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
