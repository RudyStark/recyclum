{% extends 'base.html.twig' %}

{% block title %}Mon Panier | Recyclum{% endblock %}

{# 🔐 TOKENS CSRF pour tous les items du panier #}
{% block head %}
    {{ parent() }}
    {% for item in cart.items %}
        <meta name="csrf-token-update_cart_item_{{ item.id }}" content="{{ csrf_token('update_cart_item_' ~ item.id) }}">
        <meta name="csrf-token-remove_cart_item_{{ item.id }}" content="{{ csrf_token('remove_cart_item_' ~ item.id) }}">
    {% endfor %}
{% endblock %}

{% block body %}

    {# === HERO MODERNE === #}
    <section class="cart-hero-modern">
        <div class="container">
            <div class="cart-hero-content">
                <div class="cart-hero-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                </div>
                <div class="cart-hero-text">
                    <h1>Mon Panier</h1>
                    {% if not cart.isEmpty %}
                        <p>{{ cart.totalQuantity }} article{{ cart.totalQuantity > 1 ? 's' : '' }} · {{ cart.totalFormatted }}</p>
                    {% else %}
                        <p>Votre panier est vide</p>
                    {% endif %}
                </div>
            </div>

            {# Breadcrumb #}
            <nav class="cart-breadcrumb">
                <a href="{{ path('app_home') }}">Accueil</a>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
                <a href="{{ path('catalog_index') }}">Catalogue</a>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
                <span>Panier</span>
            </nav>
        </div>
    </section>

    {# === CONTENU === #}
    <section class="cart-content-modern">
        <div class="container">
            {% if not validation.valid %}
                {# Erreurs de validation #}
                <div class="cart-alert cart-alert-warning">
                    <div class="cart-alert-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                    </div>
                    <div class="cart-alert-content">
                        <h5>Attention</h5>
                        <ul>
                            {% for error in validation.errors %}
                                <li>{{ error }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}

            {% if cart.isEmpty %}
                {# === PANIER VIDE - DESIGN MODERNE === #}
                <div class="cart-empty-modern">
                    <div class="cart-empty-illustration">
                        <svg width="160" height="160" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                    </div>
                    <h2>Votre panier est vide</h2>
                    <p>Découvrez notre sélection d'électroménager reconditionné de qualité professionnelle</p>
                    <a href="{{ path('catalog_index') }}" class="btn-cart-primary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                            <path d="M3 9h18M9 21V9"></path>
                        </svg>
                        Parcourir le catalogue
                    </a>
                </div>
            {% else %}
                {# === PANIER AVEC PRODUITS === #}
                <div class="cart-grid">
                    {# === COLONNE GAUCHE : PRODUITS === #}
                    <div class="cart-products">
                        <div class="cart-products-header">
                            <h2>Articles ({{ cart.totalQuantity }})</h2>
                            <button
                                type="button"
                                class="btn-cart-clear"
                                data-controller="cart"
                                data-action="click->cart#clearCart"
                            >
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                                Vider le panier
                            </button>
                        </div>

                        <div class="cart-products-list" data-controller="cart">
                            {% for item in cart.items %}
                                {% set product = item.product %}
                                {% set firstImage = product.images|first %}
                                {% set maxQuantity = min(10, product.stock) %}
                                {% set canIncrease = item.quantity < maxQuantity %}
                                {% set canDecrease = item.quantity > 1 %}

                                <div class="cart-product-card" id="cart-item-{{ item.id }}" data-cart-target="item">
                                    {# Image #}
                                    <div class="cart-product-image">
                                        <a href="{{ path('catalog_show', {slug: product.slug}) }}">
                                            {% if firstImage %}
                                                <img src="/uploads/products/{{ firstImage.filename }}" alt="{{ product.title }}">
                                            {% else %}
                                                <div class="cart-product-image-placeholder">
                                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                                        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                                        <polyline points="21 15 16 10 5 21"></polyline>
                                                    </svg>
                                                </div>
                                            {% endif %}
                                        </a>
                                    </div>

                                    {# Détails #}
                                    <div class="cart-product-details">
                                        <div class="cart-product-header">
                                            <div>
                                                <h3 class="cart-product-title">
                                                    <a href="{{ path('catalog_show', {slug: product.slug}) }}">
                                                        {{ product.title }}
                                                    </a>
                                                </h3>
                                                <div class="cart-product-meta">
                                                    {% if product.brand %}
                                                        <span>{{ product.brand.name }}</span>
                                                    {% endif %}
                                                    {% if product.category %}
                                                        <span>{{ product.category.name }}</span>
                                                    {% endif %}
                                                </div>
                                            </div>

                                            {# Bouton supprimer mobile #}
                                            <button
                                                type="button"
                                                class="cart-product-remove-mobile"
                                                data-action="click->cart#removeItem"
                                                data-item-id="{{ item.id }}"
                                                title="Retirer"
                                            >
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                            </button>
                                        </div>

                                        {# Prix et quantité #}
                                        <div class="cart-product-actions">
                                            {# Quantité #}
                                            <div class="cart-product-quantity">
                                                <button
                                                    type="button"
                                                    class="cart-qty-btn"
                                                    data-action="click->cart#decreaseQuantity"
                                                    data-item-id="{{ item.id }}"
                                                    {{ item.quantity <= 1 ? 'disabled' : '' }}
                                                    title="{{ item.quantity <= 1 ? 'Quantité minimale atteinte' : 'Diminuer la quantité' }}"
                                                >
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                                    </svg>
                                                </button>

                                                <input
                                                    type="number"
                                                    class="cart-qty-input"
                                                    value="{{ item.quantity }}"
                                                    min="1"
                                                    max="{{ maxQuantity }}"
                                                    data-cart-target="quantityInput"
                                                    data-item-id="{{ item.id }}"
                                                    data-max-quantity="{{ maxQuantity }}"
                                                    data-action="change->cart#updateQuantity"
                                                >

                                                <button
                                                    type="button"
                                                    class="cart-qty-btn"
                                                    data-action="click->cart#increaseQuantity"
                                                    data-item-id="{{ item.id }}"
                                                    {{ item.quantity >= maxQuantity ? 'disabled' : '' }}
                                                    title="{{ item.quantity >= maxQuantity ? 'Stock maximum atteint (' ~ maxQuantity ~ ')' : 'Augmenter la quantité' }}"
                                                >
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                                    </svg>
                                                </button>
                                            </div>

                                            {# Avertissement stock faible #}
                                            {% if product.stock <= 3 and product.stock > 0 %}
                                                <div class="cart-product-stock-warning">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                                        <line x1="12" y1="9" x2="12" y2="13"></line>
                                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                                    </svg>
                                                    Plus que {{ product.stock }} en stock
                                                </div>
                                            {% endif %}

                                            {# Prix #}
                                            <div class="cart-product-pricing">
                                                {% if item.quantity > 1 %}
                                                    <div class="cart-product-unit-price">
                                                        {{ item.unitPriceFormatted }} × {{ item.quantity }}
                                                    </div>
                                                {% endif %}
                                                <div class="cart-product-subtotal" data-cart-target="subtotal" data-item-id="{{ item.id }}">
                                                    {{ item.subtotalFormatted }}
                                                </div>
                                            </div>

                                            {# Bouton supprimer desktop #}
                                            <button
                                                type="button"
                                                class="cart-product-remove-desktop"
                                                data-action="click->cart#removeItem"
                                                data-item-id="{{ item.id }}"
                                                title="Retirer du panier"
                                            >
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        {# Continuer les achats #}
                        <div class="cart-continue">
                            <a href="{{ path('catalog_index') }}" class="btn-cart-continue">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="19" y1="12" x2="5" y2="12"></line>
                                    <polyline points="12 19 5 12 12 5"></polyline>
                                </svg>
                                Continuer mes achats
                            </a>
                        </div>
                    </div>

                    {# === COLONNE DROITE : RÉCAPITULATIF === #}
                    <div class="cart-sidebar">
                        {# Récapitulatif #}
                        <div class="cart-summary-modern" data-controller="cart" data-cart-target="summary">
                            <h3>Récapitulatif</h3>

                            <div class="cart-summary-lines">
                                <div class="cart-summary-line">
                                    <span>Sous-total</span>
                                    <span data-cart-target="totalAmount">{{ cart.totalFormatted }}</span>
                                </div>

                                <div class="cart-summary-line cart-summary-line-muted">
                                    <span>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="1" y="3" width="15" height="13"></rect>
                                            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                            <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                            <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                        </svg>
                                        Livraison
                                    </span>
                                    <span>Calculée à l'étape suivante</span>
                                </div>
                            </div>

                            <div class="cart-summary-total">
                                <span>Total</span>
                                <span data-cart-target="totalAmount">{{ cart.totalFormatted }}</span>
                            </div>

                            <a
                                href="{{ path('checkout_index') }}"
                                class="btn-cart-checkout {{ not validation.valid ? 'disabled' : '' }}"
                                {% if not validation.valid %}onclick="return false;"{% endif %}
                            >
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                Passer commande
                            </a>

                            {% if not validation.valid %}
                                <p class="cart-summary-error">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                    </svg>
                                    Veuillez corriger les erreurs ci-dessus
                                </p>
                            {% endif %}

                            {# Features #}
                            <div class="cart-summary-features">
                                <div class="cart-feature-modern">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    </svg>
                                    <span>Paiement 100% sécurisé</span>
                                </div>
                                <div class="cart-feature-modern">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="1" y="3" width="15" height="13"></rect>
                                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                    </svg>
                                    <span>Livraison en Île-de-France</span>
                                </div>
                                <div class="cart-feature-modern">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span>Garantie jusqu'à 24 mois</span>
                                </div>
                            </div>
                        </div>

                        {# Info livraison #}
                        <div class="cart-delivery-modern">
                            <div class="cart-delivery-header">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="3" width="15" height="13"></rect>
                                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                </svg>
                                <h4>Livraison</h4>
                            </div>
                            <p>Livraison en Île-de-France sous 2 à 5 jours ouvrés</p>
                            <ul>
                                <li>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    Livraison simple : <strong>20€</strong>
                                </li>
                                <li>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    Livraison + Installation : <strong>30€</strong>
                                </li>
                            </ul>
                            <a href="{{ path('app_delivery') }}" class="cart-delivery-learn-more">
                                En savoir plus
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>

{% endblock %}
