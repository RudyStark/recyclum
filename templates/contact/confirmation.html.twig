{% extends 'base.html.twig' %}

{% block title %}Message envoyé | Recyclum{% endblock %}

{% block body %}
    <div class="contact-confirmation-page">
        <div class="container py-5">
            <div class="confirmation-card">
                <div class="confirmation-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <h1>Message envoyé avec succès !</h1>

                <div class="ticket-badge">
                    <span class="label">Numéro de ticket</span>
                    <span class="number">{{ contactMessage.ticketNumber }}</span>
                </div>

                <p class="confirmation-text">
                    Merci pour votre message, <strong>{{ contactMessage.firstName }}</strong>.
                    <br>
                    Notre équipe vous répondra sous <strong>24 heures</strong>.
                </p>

                <div class="confirmation-details">
                    <div class="detail-row">
                        <span class="label">
                            <i class="bi bi-tag"></i>
                            Sujet
                        </span>
                        <span class="value">{{ contactMessage.subject.label }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="label">
                            <i class="bi bi-envelope"></i>
                            Email de confirmation
                        </span>
                        <span class="value">{{ contactMessage.email }}</span>
                    </div>
                    {% if contactMessage.relatedOrder %}
                        <div class="detail-row">
                            <span class="label">
                                <i class="bi bi-bag"></i>
                                Commande
                            </span>
                            <span class="value">{{ contactMessage.relatedOrder.orderNumber }}</span>
                        </div>
                    {% endif %}
                    {% if contactMessage.relatedOrderItem %}
                        <div class="detail-row">
                            <span class="label">
                                <i class="bi bi-box"></i>
                                Produit
                            </span>
                            <span class="value">{{ contactMessage.relatedOrderItem.productName }}</span>
                        </div>
                    {% endif %}
                </div>

                <div class="confirmation-message-preview">
                    <h4>Votre message</h4>
                    <p>{{ contactMessage.message|nl2br }}</p>
                </div>

                <div class="confirmation-actions">
                    <a href="{{ path('app_home') }}" class="btn btn-primary btn-lg">
                        <i class="bi bi-house"></i>
                        Retour à l'accueil
                    </a>
                    <a href="{{ path('catalog_index') }}" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-grid"></i>
                        Voir nos produits
                    </a>
                </div>

                <div class="confirmation-note">
                    <i class="bi bi-info-circle"></i>
                    Conservez votre numéro de ticket <strong>{{ contactMessage.ticketNumber }}</strong>
                    pour tout suivi de votre demande.
                </div>
            </div>
        </div>
    </div>
{% endblock %}
