<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message reçu</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #F9FAFB;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #F9FAFB;">
    <tr>
        <td align="center" style="padding: 20px 0;">
            <table width="600" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff; border-radius: 8px; overflow: hidden;">
                <!-- Header -->
                <tr>
                    <td style="background: linear-gradient(135deg, #16C669 0%, #12A855 100%); padding: 40px 30px; text-align: center;">
                        <span style="font-size: 28px; font-weight: 900; color: #ffffff;">RECYCLUM</span>
                    </td>
                </tr>

                <!-- Body -->
                <tr>
                    <td style="padding: 40px 30px;">
                        <!-- Icon -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td align="center" style="padding-bottom: 20px;">
                                    <span style="font-size: 64px; line-height: 1;">&#9989;</span>
                                </td>
                            </tr>
                        </table>

                        <!-- Title -->
                        <h1 style="font-size: 28px; font-weight: 800; color: #1F2937; text-align: center; margin: 0 0 10px 0;">Message bien reçu !</h1>
                        <p style="font-size: 16px; color: #6B7280; text-align: center; margin: 0 0 30px 0;">Merci de nous avoir contactés, {{ contactMessage.firstName }} !</p>

                        <!-- Ticket Info -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background: linear-gradient(135deg, rgba(22, 198, 105, 0.1) 0%, rgba(22, 198, 105, 0.05) 100%); border: 2px solid rgba(22, 198, 105, 0.3); border-radius: 12px; margin-bottom: 30px;">
                            <tr>
                                <td style="padding: 25px; text-align: center;">
                                    <p style="margin: 0 0 5px 0; font-size: 13px; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px;">Numéro de ticket</p>
                                    <p style="margin: 0; font-size: 24px; font-weight: 900; color: #16C669; font-family: monospace;">{{ contactMessage.ticketNumber }}</p>
                                </td>
                            </tr>
                        </table>

                        <!-- Message Details -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #F9FAFB; border: 2px solid #E5E7EB; border-radius: 12px; margin-bottom: 30px;">
                            <tr>
                                <td style="padding: 20px;">
                                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td style="padding: 8px 0; font-size: 15px; color: #6B7280; font-weight: 600;">Sujet</td>
                                            <td style="padding: 8px 0; font-size: 15px; color: #1F2937; font-weight: 700; text-align: right;">{{ contactMessage.subject.label }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px 0; font-size: 15px; color: #6B7280; font-weight: 600;">Date</td>
                                            <td style="padding: 8px 0; font-size: 15px; color: #1F2937; font-weight: 700; text-align: right;">{{ contactMessage.createdAt|date('d/m/Y à H:i') }}</td>
                                        </tr>
                                        {% if contactMessage.relatedOrder %}
                                        <tr>
                                            <td style="padding: 8px 0; font-size: 15px; color: #6B7280; font-weight: 600;">Commande</td>
                                            <td style="padding: 8px 0; font-size: 15px; color: #1F2937; font-weight: 700; text-align: right;">{{ contactMessage.relatedOrder.orderNumber }}</td>
                                        </tr>
                                        {% endif %}
                                        {% if contactMessage.relatedOrderItem %}
                                        <tr>
                                            <td style="padding: 8px 0; font-size: 15px; color: #6B7280; font-weight: 600;">Produit</td>
                                            <td style="padding: 8px 0; font-size: 15px; color: #1F2937; font-weight: 700; text-align: right;">{{ contactMessage.relatedOrderItem.productName }}</td>
                                        </tr>
                                        {% endif %}
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Your Message -->
                        <h3 style="margin: 0 0 15px 0; color: #1F2937; font-size: 16px;">&#128172; Votre message</h3>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #F9FAFB; border-radius: 12px; margin-bottom: 30px;">
                            <tr>
                                <td style="padding: 20px;">
                                    <p style="margin: 0; font-size: 14px; color: #4B5563; line-height: 1.7;">{{ contactMessage.message|nl2br }}</p>
                                </td>
                            </tr>
                        </table>

                        <!-- What's Next -->
                        <h3 style="margin: 0 0 20px 0; color: #1F2937; font-size: 16px;">Et maintenant ?</h3>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 30px;">
                            <tr>
                                <td style="padding-bottom: 15px;">
                                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td width="40" valign="top">
                                                <div style="width: 32px; height: 32px; background: #16C669; border-radius: 50%; color: white; font-weight: 900; font-size: 16px; line-height: 32px; text-align: center;">1</div>
                                            </td>
                                            <td valign="top" style="padding-left: 12px;">
                                                <p style="margin: 0 0 5px 0; font-size: 15px; font-weight: 700; color: #1F2937;">Analyse</p>
                                                <p style="margin: 0; font-size: 14px; color: #6B7280; line-height: 1.5;">Notre équipe analyse votre demande.</p>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom: 15px;">
                                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td width="40" valign="top">
                                                <div style="width: 32px; height: 32px; background: #16C669; border-radius: 50%; color: white; font-weight: 900; font-size: 16px; line-height: 32px; text-align: center;">2</div>
                                            </td>
                                            <td valign="top" style="padding-left: 12px;">
                                                <p style="margin: 0 0 5px 0; font-size: 15px; font-weight: 700; color: #1F2937;">Réponse sous 24h</p>
                                                <p style="margin: 0; font-size: 14px; color: #6B7280; line-height: 1.5;">Vous recevrez une réponse par email.</p>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        {% if ticketUrl %}
                        <!-- Follow Ticket Button -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 30px;">
                            <tr>
                                <td align="center">
                                    <a href="{{ ticketUrl }}" style="display: inline-block; background: linear-gradient(135deg, #16C669 0%, #12A855 100%); color: #ffffff; text-decoration: none; padding: 16px 40px; border-radius: 8px; font-weight: 700; font-size: 16px;">
                                        &#128269; Suivre mon ticket
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td align="center" style="padding-top: 12px;">
                                    <p style="margin: 0; font-size: 13px; color: #6B7280;">Consultez l'historique et répondez directement en ligne</p>
                                </td>
                            </tr>
                        </table>
                        {% endif %}

                        <!-- Important Note -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #FFFBEB; border: 1px solid #FCD34D; border-radius: 8px;">
                            <tr>
                                <td style="padding: 15px 20px;">
                                    <p style="margin: 0; font-size: 13px; color: #92400E; line-height: 1.5;">
                                        <strong>&#9888;&#65039; Important :</strong> Conservez votre numéro de ticket <strong>{{ contactMessage.ticketNumber }}</strong> pour tout suivi de votre demande.
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="background: #1F2937; padding: 30px; text-align: center;">
                        <p style="margin: 0 0 10px 0; font-size: 13px; color: #ffffff;">&#128222; 01 43 07 63 63 | 146 Avenue Daumesnil, 75012 Paris</p>
                        <p style="margin: 0; font-size: 13px; color: rgba(255,255,255,0.7);">&copy; {{ "now"|date('Y') }} Recyclum - Electroménager reconditionné</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
