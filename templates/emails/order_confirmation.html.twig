<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmation de commande</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #F9FAFB;
        }
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }
        .email-header {
            background: linear-gradient(135deg, #16C669 0%, #12A855 100%);
            padding: 40px 30px;
            text-align: center;
        }
        .email-logo {
            font-size: 28px;
            font-weight: 900;
            color: #ffffff;
            text-decoration: none;
        }
        .email-body {
            padding: 40px 30px;
        }
        .success-icon {
            text-align: center;
            margin-bottom: 30px;
        }
        .success-icon svg {
            width: 80px;
            height: 80px;
        }
        h1 {
            font-size: 28px;
            font-weight: 800;
            color: #1F2937;
            text-align: center;
            margin: 0 0 10px;
        }
        .subtitle {
            font-size: 16px;
            color: #6B7280;
            text-align: center;
            margin: 0 0 30px;
        }
        .info-box {
            background: #F9FAFB;
            border: 2px solid #E5E7EB;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 30px;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 15px;
        }
        .info-row:last-child {
            margin-bottom: 0;
        }
        .info-label {
            color: #6B7280;
            font-weight: 600;
        }
        .info-value {
            color: #1F2937;
            font-weight: 700;
        }
        .info-value.highlight {
            color: #16C669;
            font-size: 18px;
        }
        .tracking-box {
            background: linear-gradient(135deg, rgba(22, 198, 105, 0.1) 0%, rgba(22, 198, 105, 0.05) 100%);
            border: 2px solid rgba(22, 198, 105, 0.3);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 30px;
            text-align: center;
        }
        .tracking-box h3 {
            font-size: 16px;
            color: #1F2937;
            margin: 0 0 15px;
        }
        .tracking-button {
            display: inline-block;
            padding: 14px 30px;
            background: linear-gradient(135deg, #16C669 0%, #12A855 100%);
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 15px;
        }
        .products-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .products-table th {
            background: #F9FAFB;
            padding: 12px;
            text-align: left;
            font-size: 13px;
            font-weight: 700;
            color: #6B7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .products-table td {
            padding: 15px 12px;
            border-bottom: 1px solid #E5E7EB;
            font-size: 14px;
            color: #1F2937;
        }
        .products-table tr:last-child td {
            border-bottom: none;
        }
        .total-line {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            font-size: 15px;
        }
        .total-line.final {
            border-top: 2px solid #E5E7EB;
            padding-top: 15px;
            margin-top: 10px;
            font-size: 18px;
            font-weight: 900;
        }
        .total-line.final .amount {
            color: #16C669;
        }
        .address-box {
            background: #F9FAFB;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 30px;
        }
        .address-box h3 {
            font-size: 16px;
            color: #1F2937;
            margin: 0 0 12px;
            font-weight: 700;
        }
        .address-box p {
            margin: 0;
            line-height: 1.6;
            color: #4B5563;
            font-size: 14px;
        }
        .steps {
            margin: 30px 0;
        }
        .step {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }
        .step-number {
            width: 32px;
            height: 32px;
            background: #16C669;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 16px;
            flex-shrink: 0;
        }
        .step-content h4 {
            margin: 0 0 5px;
            font-size: 15px;
            color: #1F2937;
        }
        .step-content p {
            margin: 0;
            font-size: 14px;
            color: #6B7280;
            line-height: 1.5;
        }
        .email-footer {
            background: #1F2937;
            color: #ffffff;
            padding: 30px;
            text-align: center;
            font-size: 13px;
        }
        .email-footer a {
            color: #16C669;
            text-decoration: none;
        }
    </style>
</head>
<body>
<div class="email-container">
    <!-- Header -->
    <div class="email-header">
        <div class="email-logo">RECYCLUM</div>
    </div>

    <!-- Body -->
    <div class="email-body">
        <!-- Success Icon -->
        <div class="success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16C669" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>

        <h1>Commande confirmée !</h1>
        <p class="subtitle">Merci pour votre confiance, {{ order.deliveryFirstName }} !</p>

        <!-- Order Info -->
        <div class="info-box">
            <div class="info-row">
                <span class="info-label">Numéro de commande</span>
                <span class="info-value">{{ order.orderNumber }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Date</span>
                <span class="info-value">{{ order.createdAt|date('d/m/Y à H:i') }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Montant payé</span>
                <span class="info-value highlight">{{ order.totalFormatted }}</span>
            </div>
        </div>

        <!-- Tracking Link (for guests) -->
        {% if trackingUrl %}
            <div class="tracking-box">
                <h3>📦 Suivez votre commande</h3>
                <a href="{{ trackingUrl }}" class="tracking-button">Accéder au suivi</a>
                <p style="margin-top: 15px; font-size: 13px; color: #6B7280;">
                    Conservez ce lien pour suivre votre commande à tout moment
                </p>
            </div>
        {% endif %}

        <!-- Products -->
        <h3 style="margin-bottom: 15px; color: #1F2937;">Détail de votre commande</h3>
        <table class="products-table">
            <thead>
            <tr>
                <th>Produit</th>
                <th style="text-align: center;">Qté</th>
                <th style="text-align: right;">Prix</th>
            </tr>
            </thead>
            <tbody>
            {% for item in order.items %}
                <tr>
                    <td>
                        <strong>{{ item.productTitle }}</strong><br>
                        <span style="color: #6B7280; font-size: 13px;">{{ item.productBrand }}</span>
                    </td>
                    <td style="text-align: center;">{{ item.quantity }}</td>
                    <td style="text-align: right; font-weight: 700; color: #16C669;">{{ item.subtotalFormatted }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="info-box">
            <div class="total-line">
                <span>Sous-total</span>
                <span>{{ order.subtotalFormatted }}</span>
            </div>
            <div class="total-line">
                <span>Livraison</span>
                <span>{{ order.deliveryPriceFormatted }}</span>
            </div>
            <div class="total-line final">
                <span>Total TTC</span>
                <span class="amount">{{ order.totalFormatted }}</span>
            </div>
        </div>

        <!-- Delivery Address -->
        <div class="address-box">
            <h3>📍 Adresse de livraison</h3>
            <p>
                <strong>{{ order.deliveryFirstName }} {{ order.deliveryLastName }}</strong><br>
                {{ order.deliveryStreet }}<br>
                {% if order.deliveryStreetComplement %}
                    {{ order.deliveryStreetComplement }}<br>
                {% endif %}
                {{ order.deliveryPostalCode }} {{ order.deliveryCity }}<br>
                <strong>Tél :</strong> {{ order.deliveryPhone }}
            </p>
        </div>

        <!-- Next Steps -->
        <h3 style="margin-bottom: 20px; color: #1F2937;">Et maintenant ?</h3>
        <div class="steps">
            <div class="step">
                <div class="step-number">1</div>
                <div class="step-content">
                    <h4>Préparation</h4>
                    <p>Votre commande sera préparée dans les 24 à 48 heures.</p>
                </div>
            </div>
            <div class="step">
                <div class="step-number">2</div>
                <div class="step-content">
                    <h4>Livraison</h4>
                    <p>Nos livreurs vous contacteront pour convenir d'un créneau.</p>
                </div>
            </div>
            <div class="step">
                <div class="step-number">3</div>
                <div class="step-content">
                    <h4>Profitez !</h4>
                    <p>Recevez votre appareil reconditionné avec garantie.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="email-footer">
        <p>Une question ? <a href="mailto:contact@recyclum.com">Contactez-nous</a></p>
        <p style="margin-top: 10px; opacity: 0.8;">
            © {{ "now"|date('Y') }} Recyclum - Électroménager reconditionné
        </p>
    </div>
</div>
</body>
</html>
