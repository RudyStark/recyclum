<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmation de commande</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #F9FAFB;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #F9FAFB;">
    <tr>
        <td align="center" style="padding: 20px 0;">
            <table width="600" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff; border-radius: 8px; overflow: hidden;">
                <!-- Header -->
                <tr>
                    <td style="background: linear-gradient(135deg, #16C669 0%, #12A855 100%); padding: 40px 30px; text-align: center;">
                        <span style="font-size: 28px; font-weight: 900; color: #ffffff;">RECYCLUM</span>
                    </td>
                </tr>

                <!-- Body -->
                <tr>
                    <td style="padding: 40px 30px;">
                        <!-- Icon -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td align="center" style="padding-bottom: 20px;">
                                    <span style="font-size: 64px; line-height: 1;">&#9989;</span>
                                </td>
                            </tr>
                        </table>

                        <!-- Title -->
                        <h1 style="font-size: 28px; font-weight: 800; color: #1F2937; text-align: center; margin: 0 0 10px 0;">Commande confirmée !</h1>
                        <p style="font-size: 16px; color: #6B7280; text-align: center; margin: 0 0 30px 0;">Merci pour votre confiance, {{ order.deliveryFirstName }} !</p>

                        <!-- Order Info -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #F9FAFB; border: 2px solid #E5E7EB; border-radius: 12px; margin-bottom: 30px;">
                            <tr>
                                <td style="padding: 20px;">
                                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td style="padding: 8px 0; font-size: 15px; color: #6B7280; font-weight: 600;">Numéro de commande</td>
                                            <td style="padding: 8px 0; font-size: 15px; color: #1F2937; font-weight: 700; text-align: right;">{{ order.orderNumber }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px 0; font-size: 15px; color: #6B7280; font-weight: 600;">Date</td>
                                            <td style="padding: 8px 0; font-size: 15px; color: #1F2937; font-weight: 700; text-align: right;">{{ order.createdAt|date('d/m/Y à H:i') }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px 0; font-size: 15px; color: #6B7280; font-weight: 600;">Montant payé</td>
                                            <td style="padding: 8px 0; font-size: 18px; color: #16C669; font-weight: 700; text-align: right;">{{ order.totalFormatted }}</td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Tracking Link (for guests) -->
                        {% if trackingUrl %}
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background: linear-gradient(135deg, rgba(22, 198, 105, 0.1) 0%, rgba(22, 198, 105, 0.05) 100%); border: 2px solid rgba(22, 198, 105, 0.3); border-radius: 12px; margin-bottom: 30px;">
                            <tr>
                                <td style="padding: 25px; text-align: center;">
                                    <h3 style="margin: 0 0 15px 0; font-size: 16px; color: #1F2937;">&#128230; Suivez votre commande</h3>
                                    <a href="{{ trackingUrl }}" style="display: inline-block; padding: 14px 30px; background: linear-gradient(135deg, #16C669 0%, #12A855 100%); color: #ffffff; text-decoration: none; border-radius: 10px; font-weight: 700; font-size: 15px;">Accéder au suivi</a>
                                    <p style="margin: 15px 0 0 0; font-size: 13px; color: #6B7280;">
                                        Conservez ce lien pour suivre votre commande à tout moment
                                    </p>
                                </td>
                            </tr>
                        </table>
                        {% endif %}

                        <!-- Products -->
                        <h3 style="margin: 0 0 15px 0; color: #1F2937; font-size: 16px;">Détail de votre commande</h3>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 20px;">
                            <tr style="background: #F9FAFB;">
                                <td style="padding: 12px; font-size: 13px; font-weight: 700; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px;">Produit</td>
                                <td style="padding: 12px; font-size: 13px; font-weight: 700; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px; text-align: center;">Qté</td>
                                <td style="padding: 12px; font-size: 13px; font-weight: 700; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px; text-align: right;">Prix</td>
                            </tr>
                            {% for item in order.items %}
                            <tr>
                                <td style="padding: 15px 12px; border-bottom: 1px solid #E5E7EB;">
                                    <p style="margin: 0 0 4px 0; font-size: 14px; font-weight: 700; color: #1F2937;">{{ item.productTitle }}</p>
                                    <p style="margin: 0; font-size: 13px; color: #6B7280;">{{ item.productBrand }}</p>
                                </td>
                                <td style="padding: 15px 12px; border-bottom: 1px solid #E5E7EB; text-align: center; font-size: 14px; color: #1F2937;">{{ item.quantity }}</td>
                                <td style="padding: 15px 12px; border-bottom: 1px solid #E5E7EB; text-align: right; font-size: 14px; font-weight: 700; color: #16C669;">{{ item.subtotalFormatted }}</td>
                            </tr>
                            {% endfor %}
                        </table>

                        <!-- Totals -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #F9FAFB; border: 2px solid #E5E7EB; border-radius: 12px; margin-bottom: 30px;">
                            <tr>
                                <td style="padding: 20px;">
                                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td style="padding: 8px 0; font-size: 15px; color: #6B7280;">Sous-total</td>
                                            <td style="padding: 8px 0; font-size: 15px; color: #1F2937; text-align: right;">{{ order.subtotalFormatted }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px 0; font-size: 15px; color: #6B7280;">Livraison</td>
                                            <td style="padding: 8px 0; font-size: 15px; color: #1F2937; text-align: right;">{{ order.deliveryPriceFormatted }}</td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="padding-top: 10px; border-top: 2px solid #E5E7EB;">
                                                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                                    <tr>
                                                        <td style="padding: 8px 0; font-size: 18px; font-weight: 900; color: #1F2937;">Total TTC</td>
                                                        <td style="padding: 8px 0; font-size: 18px; font-weight: 900; color: #16C669; text-align: right;">{{ order.totalFormatted }}</td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Delivery Address -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #F9FAFB; border-radius: 12px; margin-bottom: 30px;">
                            <tr>
                                <td style="padding: 20px;">
                                    <h3 style="margin: 0 0 15px 0; font-size: 16px; color: #1F2937; font-weight: 700;">&#128205; Adresse de livraison</h3>
                                    <p style="margin: 0; line-height: 1.8; color: #4B5563; font-size: 14px;">
                                        <strong>{{ order.deliveryFirstName }} {{ order.deliveryLastName }}</strong><br>
                                        {{ order.deliveryStreet }}<br>
                                        {% if order.deliveryStreetComplement %}{{ order.deliveryStreetComplement }}<br>{% endif %}
                                        {{ order.deliveryPostalCode }} {{ order.deliveryCity }}<br>
                                        &#128222; {{ order.deliveryPhone }}
                                    </p>
                                </td>
                            </tr>
                        </table>

                        <!-- Next Steps -->
                        <h3 style="margin: 0 0 20px 0; color: #1F2937; font-size: 16px;">Et maintenant ?</h3>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 30px;">
                            <!-- Step 1 -->
                            <tr>
                                <td style="padding-bottom: 20px;">
                                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td width="40" valign="top">
                                                <div style="width: 32px; height: 32px; background: #16C669; border-radius: 50%; color: white; font-weight: 900; font-size: 16px; line-height: 32px; text-align: center;">1</div>
                                            </td>
                                            <td valign="top" style="padding-left: 12px;">
                                                <p style="margin: 0 0 5px 0; font-size: 15px; font-weight: 700; color: #1F2937;">Préparation</p>
                                                <p style="margin: 0; font-size: 14px; color: #6B7280; line-height: 1.5;">Votre commande sera préparée dans les 24 à 48 heures.</p>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <!-- Step 2 -->
                            <tr>
                                <td style="padding-bottom: 20px;">
                                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td width="40" valign="top">
                                                <div style="width: 32px; height: 32px; background: #16C669; border-radius: 50%; color: white; font-weight: 900; font-size: 16px; line-height: 32px; text-align: center;">2</div>
                                            </td>
                                            <td valign="top" style="padding-left: 12px;">
                                                <p style="margin: 0 0 5px 0; font-size: 15px; font-weight: 700; color: #1F2937;">Livraison</p>
                                                <p style="margin: 0; font-size: 14px; color: #6B7280; line-height: 1.5;">Nos livreurs vous contacteront pour convenir d'un créneau.</p>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <!-- Step 3 -->
                            <tr>
                                <td>
                                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td width="40" valign="top">
                                                <div style="width: 32px; height: 32px; background: #16C669; border-radius: 50%; color: white; font-weight: 900; font-size: 16px; line-height: 32px; text-align: center;">3</div>
                                            </td>
                                            <td valign="top" style="padding-left: 12px;">
                                                <p style="margin: 0 0 5px 0; font-size: 15px; font-weight: 700; color: #1F2937;">Profitez !</p>
                                                <p style="margin: 0; font-size: 14px; color: #6B7280; line-height: 1.5;">Recevez votre appareil reconditionné avec garantie.</p>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="background: #1F2937; padding: 30px; text-align: center;">
                        <p style="margin: 0 0 10px 0; font-size: 13px; color: #ffffff;">Une question ? <a href="mailto:contact@recyclum.com" style="color: #16C669; text-decoration: none;">Contactez-nous</a></p>
                        <p style="margin: 0; font-size: 13px; color: rgba(255,255,255,0.7);">&copy; {{ "now"|date('Y') }} Recyclum - Electroménager reconditionné</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
