<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouvelle réponse client - Recyclum</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f4f4f5;">
    <table role="presentation" style="width: 100%; border-collapse: collapse;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <table role="presentation" style="width: 100%; max-width: 600px; border-collapse: collapse;">
                    {# Header #}
                    <tr>
                        <td style="background: linear-gradient(135deg, #1a1a2e 0%, #2d2d44 100%); padding: 30px; border-radius: 16px 16px 0 0; text-align: center;">
                            <div style="display: inline-block; background: rgba(255,255,255,0.1); padding: 12px; border-radius: 12px; margin-bottom: 15px;">
                                <span style="font-size: 28px;">💬</span>
                            </div>
                            <h1 style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 600;">
                                Nouvelle réponse client
                            </h1>
                            <p style="color: rgba(255,255,255,0.7); margin: 10px 0 0; font-size: 14px;">
                                Ticket {{ contactMessage.ticketNumber }}
                            </p>
                        </td>
                    </tr>

                    {# Content #}
                    <tr>
                        <td style="background-color: #ffffff; padding: 30px;">
                            {# Alert #}
                            <div style="background: #fef3c7; border-left: 4px solid #f59e0b; padding: 15px; border-radius: 8px; margin-bottom: 25px;">
                                <p style="margin: 0; color: #92400e; font-size: 14px;">
                                    <strong>{{ contactMessage.fullName }}</strong> a répondu à son ticket de support.
                                </p>
                            </div>

                            {# Ticket Info #}
                            <div style="background: #f8fafc; border-radius: 12px; padding: 20px; margin-bottom: 25px;">
                                <h3 style="margin: 0 0 15px; color: #1f2937; font-size: 16px;">
                                    Informations du ticket
                                </h3>
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 8px 0; color: #6b7280; font-size: 14px; width: 120px;">Numéro</td>
                                        <td style="padding: 8px 0; color: #1f2937; font-size: 14px; font-weight: 600;">{{ contactMessage.ticketNumber }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 0; color: #6b7280; font-size: 14px;">Client</td>
                                        <td style="padding: 8px 0; color: #1f2937; font-size: 14px;">{{ contactMessage.fullName }} ({{ contactMessage.email }})</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 0; color: #6b7280; font-size: 14px;">Sujet</td>
                                        <td style="padding: 8px 0; color: #1f2937; font-size: 14px;">{{ contactMessage.subject.label }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 0; color: #6b7280; font-size: 14px;">Statut</td>
                                        <td style="padding: 8px 0;">
                                            <span style="display: inline-block; background: #dbeafe; color: #1d4ed8; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 500;">
                                                {{ contactMessage.status.label }}
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            {# New Reply #}
                            <div style="margin-bottom: 25px;">
                                <h3 style="margin: 0 0 15px; color: #1f2937; font-size: 16px;">
                                    Nouveau message du client
                                </h3>
                                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 20px;">
                                    <p style="margin: 0; color: #166534; font-size: 14px; line-height: 1.6; white-space: pre-wrap;">{{ reply.content }}</p>
                                    <p style="margin: 15px 0 0; color: #6b7280; font-size: 12px;">
                                        Envoyé le {{ reply.createdAt|date('d/m/Y à H:i') }}
                                    </p>
                                </div>
                            </div>

                            {# CTA #}
                            <div style="text-align: center; margin-top: 30px;">
                                <a href="{{ viewUrl }}" style="display: inline-block; background: linear-gradient(135deg, #16C669 0%, #12a857 100%); color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-weight: 600; font-size: 15px;">
                                    Voir et répondre
                                </a>
                            </div>
                        </td>
                    </tr>

                    {# Footer #}
                    <tr>
                        <td style="background-color: #f8fafc; padding: 25px 30px; border-radius: 0 0 16px 16px; text-align: center; border-top: 1px solid #e5e7eb;">
                            <p style="margin: 0; color: #6b7280; font-size: 13px;">
                                Cet email a été envoyé automatiquement par le système de tickets Recyclum.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
