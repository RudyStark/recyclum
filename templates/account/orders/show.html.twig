{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.orderNumber }} - Recyclum{% endblock %}

{% block body %}
<main class="account-page order-detail-page py-5">
    <div class="container">
        <div class="row g-4">
            {# Sidebar Navigation #}
            <div class="col-lg-3">
                {% include 'account/_sidebar.html.twig' with {active: 'orders'} %}
            </div>

            {# Main Content #}
            <div class="col-lg-9">
                {# Header #}
                <div class="order-detail-header mb-4">
                    <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                        <div>
                            <a href="{{ path('account_orders') }}" class="order-back-link mb-2 d-inline-block">
                                <i class="bi bi-arrow-left"></i>
                                Retour aux commandes
                            </a>
                            <h1 class="order-detail-title">Commande {{ order.orderNumber }}</h1>
                            <p class="order-detail-date text-muted mb-0">
                                Passée le {{ order.createdAt|date('d/m/Y à H:i') }}
                            </p>
                        </div>
                        <span class="order-status-badge status-{{ order.status.value }}">
                            {{ order.status.label }}
                        </span>
                    </div>
                </div>

                <div class="row g-4">
                    {# Left Column #}
                    <div class="col-xl-8">
                        {# Timeline #}
                        {% if order.status.value not in ['cancelled', 'refunded', 'pending'] %}
                            <div class="order-section order-timeline-section mb-4">
                                <h2 class="order-section-title">
                                    <i class="bi bi-clock-history"></i>
                                    Suivi de commande
                                </h2>
                                <div class="order-timeline">
                                    {% for step in timelineSteps %}
                                        <div class="timeline-step {% if step.completed %}completed{% endif %} {% if step.current %}current{% endif %}">
                                            <div class="timeline-icon">
                                                {% if step.completed %}
                                                    <i class="bi bi-check-lg"></i>
                                                {% else %}
                                                    {% if step.icon == 'credit-card' %}
                                                        <i class="bi bi-credit-card"></i>
                                                    {% elseif step.icon == 'package' %}
                                                        <i class="bi bi-box-seam"></i>
                                                    {% elseif step.icon == 'truck' %}
                                                        <i class="bi bi-truck"></i>
                                                    {% elseif step.icon == 'check-circle' %}
                                                        <i class="bi bi-check-circle"></i>
                                                    {% endif %}
                                                {% endif %}
                                            </div>
                                            <div class="timeline-content">
                                                <strong>{{ step.label }}</strong>
                                                <span class="timeline-desc">{{ step.description }}</span>
                                                {% if step.date %}
                                                    <span class="timeline-date">{{ step.date|date('d/m/Y à H:i') }}</span>
                                                {% endif %}
                                            </div>
                                            {% if not loop.last %}
                                                <div class="timeline-line {% if step.completed %}completed{% endif %}"></div>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        {# Cancelled/Refunded Status Message #}
                        {% if order.status.value == 'cancelled' %}
                            <div class="alert alert-danger d-flex align-items-center mb-4">
                                <i class="bi bi-x-circle-fill me-3 fs-4"></i>
                                <div>
                                    <strong>Commande annulée</strong>
                                    <p class="mb-0">Cette commande a été annulée{% if order.cancelledAt %} le {{ order.cancelledAt|date('d/m/Y à H:i') }}{% endif %}.</p>
                                </div>
                            </div>
                        {% elseif order.status.value == 'refunded' %}
                            <div class="alert alert-info d-flex align-items-center mb-4">
                                <i class="bi bi-arrow-counterclockwise me-3 fs-4"></i>
                                <div>
                                    <strong>Commande remboursée</strong>
                                    <p class="mb-0">Cette commande a été remboursée.</p>
                                </div>
                            </div>
                        {% elseif order.status.value == 'pending' %}
                            <div class="alert alert-warning mb-4">
                                <div class="d-flex align-items-center mb-3">
                                    <i class="bi bi-hourglass-split me-3 fs-4"></i>
                                    <div>
                                        <strong>En attente de paiement</strong>
                                        <p class="mb-0">Cette commande est en attente de paiement.</p>
                                    </div>
                                </div>
                                <a href="{{ path('checkout_resume', {orderNumber: order.orderNumber}) }}" class="btn btn-warning btn-lg w-100">
                                    <i class="bi bi-credit-card me-2"></i>
                                    Finaliser le paiement
                                </a>
                            </div>
                        {% endif %}

                        {# Products #}
                        <div class="order-section order-products-section mb-4">
                            <h2 class="order-section-title">
                                <i class="bi bi-box-seam"></i>
                                Articles commandés ({{ order.items|length }})
                            </h2>
                            <div class="order-products-list">
                                {% for item in order.items %}
                                    <div class="order-product-item">
                                        <div class="order-product-image">
                                            {% if item.product and item.product.mainImage %}
                                                <img src="{{ asset('uploads/products/' ~ item.product.mainImage.filename) }}" alt="{{ item.productTitle }}">
                                            {% else %}
                                                <div class="order-product-placeholder">
                                                    <i class="bi bi-image"></i>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="order-product-info">
                                            <h4 class="order-product-title">{{ item.productTitle }}</h4>
                                            <div class="order-product-meta">
                                                {% if item.productBrand %}
                                                    <span class="product-brand">{{ item.productBrand }}</span>
                                                {% endif %}
                                                {% if item.productCategory %}
                                                    <span class="product-category">{{ item.productCategory }}</span>
                                                {% endif %}
                                            </div>
                                            <span class="order-product-quantity">Quantité : {{ item.quantity }}</span>
                                        </div>
                                        <div class="order-product-price">
                                            <span class="price-unit">{{ item.unitPriceFormatted }}</span>
                                            {% if item.quantity > 1 %}
                                                <strong class="price-subtotal">{{ item.subtotalFormatted }}</strong>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    {# Right Column / Sidebar #}
                    <div class="col-xl-4">
                        {# Order Summary #}
                        <div class="order-section order-summary-section mb-4">
                            <h2 class="order-section-title">
                                <i class="bi bi-receipt"></i>
                                Récapitulatif
                            </h2>
                            <div class="order-summary">
                                <div class="summary-row">
                                    <span>Sous-total</span>
                                    <span>{{ order.subtotalFormatted }}</span>
                                </div>
                                <div class="summary-row">
                                    <span>
                                        Livraison
                                        {% if order.deliveryType == 'with_installation' %}
                                            <small>(avec installation)</small>
                                        {% endif %}
                                    </span>
                                    <span>{{ order.deliveryPriceFormatted }}</span>
                                </div>
                                <hr>
                                <div class="summary-row summary-total">
                                    <span>Total TTC</span>
                                    <strong>{{ order.totalFormatted }}</strong>
                                </div>
                            </div>
                        </div>

                        {# Delivery Address #}
                        <div class="order-section order-address-section mb-4">
                            <h2 class="order-section-title">
                                <i class="bi bi-geo-alt"></i>
                                Adresse de livraison
                            </h2>
                            <div class="order-address">
                                <strong>{{ order.deliveryFirstName }} {{ order.deliveryLastName }}</strong>
                                <p>
                                    {{ order.deliveryStreet }}<br>
                                    {% if order.deliveryStreetComplement %}
                                        {{ order.deliveryStreetComplement }}<br>
                                    {% endif %}
                                    {{ order.deliveryPostalCode }} {{ order.deliveryCity }}
                                </p>
                                <div class="order-phone">
                                    <i class="bi bi-telephone"></i>
                                    {{ order.deliveryPhone }}
                                </div>
                                {% if order.deliveryInstructions %}
                                    <div class="order-instructions mt-3">
                                        <small class="text-muted">Instructions de livraison :</small>
                                        <p class="mb-0">{{ order.deliveryInstructions }}</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Help Section #}
                        <div class="order-section order-help-section">
                            <h2 class="order-section-title">
                                <i class="bi bi-question-circle"></i>
                                Besoin d'aide ?
                            </h2>
                            <p class="text-muted mb-3">Une question concernant cette commande ?</p>
                            <a href="mailto:contact@recyclum.fr" class="btn btn-outline-primary w-100">
                                <i class="bi bi-envelope me-2"></i>
                                Contacter le support
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}
