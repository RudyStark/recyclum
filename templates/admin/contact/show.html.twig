{% extends 'admin/base_layout.html.twig' %}

{% block body_class 'admin-contact-show-page' %}
{% block page_title %}Ticket {{ message.ticketNumber }}{% endblock %}

{% block main %}
<div class="contact-show-container">
    {# Back Link #}
    <a href="{{ path('admin_contact_index') }}" class="back-link">
        <i class="bi bi-arrow-left"></i>
        Retour aux messages
    </a>

    <div class="contact-show-layout">
        {# Main Column #}
        <div class="contact-main-column">
            {# Message Header #}
            <div class="message-header-card">
                <div class="message-header-top">
                    <div class="ticket-info">
                        <span class="ticket-number">{{ message.ticketNumber }}</span>
                        {% if message.isPriority %}
                            <span class="priority-badge">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                Prioritaire
                            </span>
                        {% endif %}
                    </div>
                    <span class="contact-status-badge status-{{ message.status.value }}">
                        {{ message.status.label }}
                    </span>
                </div>
                <div class="message-subject-row">
                    <span class="subject-badge" style="--subject-color: {{ message.subject.color }}">
                        <i class="bi {{ message.subject.icon }}"></i>
                        {{ message.subject.label }}
                    </span>
                    <span class="message-date">
                        <i class="bi bi-clock"></i>
                        {{ message.createdAt|date('d/m/Y à H:i') }}
                    </span>
                </div>
            </div>

            {# Original Message #}
            <div class="conversation-card">
                <h3 class="card-title">
                    <i class="bi bi-chat-left-text"></i>
                    Conversation
                </h3>

                <div class="conversation-thread">
                    {# Original message from client #}
                    <div class="message-bubble message-client">
                        <div class="message-author">
                            <div class="author-avatar">
                                <i class="bi bi-person"></i>
                            </div>
                            <div class="author-info">
                                <strong>{{ message.fullName }}</strong>
                                <span class="message-time">{{ message.createdAt|date('d/m/Y à H:i') }}</span>
                            </div>
                        </div>
                        <div class="message-content">
                            {{ message.message|nl2br }}
                        </div>
                        {% if message.attachments|length > 0 %}
                            <div class="message-attachments">
                                <div class="attachments-label">
                                    <i class="bi bi-paperclip"></i>
                                    Pièces jointes ({{ message.attachments|length }})
                                </div>
                                <div class="attachments-grid">
                                    {% for attachment in message.attachments %}
                                        <div class="attachment-item">
                                            {% if attachment.isImage %}
                                                <a href="{{ attachment.webPath }}" target="_blank" class="attachment-image">
                                                    <img src="{{ attachment.webPath }}" alt="{{ attachment.originalFilename }}">
                                                    <span class="attachment-overlay">
                                                        <i class="bi bi-zoom-in"></i>
                                                    </span>
                                                </a>
                                            {% else %}
                                                <a href="{{ attachment.webPath }}" target="_blank" class="attachment-file" download>
                                                    <i class="bi {{ attachment.isPdf ? 'bi-file-pdf' : 'bi-file-earmark' }}"></i>
                                                    <span class="attachment-info">
                                                        <span class="attachment-name">{{ attachment.originalFilename }}</span>
                                                        <span class="attachment-size">{{ attachment.humanFileSize }}</span>
                                                    </span>
                                                </a>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    {# Replies #}
                    {% for reply in message.replies %}
                        <div class="message-bubble {{ reply.isAdminReply ? 'message-admin' : 'message-client' }}">
                            <div class="message-author">
                                <div class="author-avatar {{ reply.isAdminReply ? 'admin' : '' }}">
                                    <i class="bi {{ reply.isAdminReply ? 'bi-headset' : 'bi-person' }}"></i>
                                </div>
                                <div class="author-info">
                                    <strong>{{ reply.isAdminReply ? (reply.repliedBy ?: 'Équipe Recyclum') : message.fullName }}</strong>
                                    <span class="message-time">{{ reply.createdAt|date('d/m/Y à H:i') }}</span>
                                </div>
                            </div>
                            <div class="message-content">
                                {{ reply.content|nl2br }}
                            </div>
                            {% if reply.attachments|length > 0 %}
                                <div class="message-attachments">
                                    <div class="attachments-label">
                                        <i class="bi bi-paperclip"></i>
                                        Pièces jointes ({{ reply.attachments|length }})
                                    </div>
                                    <div class="attachments-grid">
                                        {% for attachment in reply.attachments %}
                                            <div class="attachment-item">
                                                {% if attachment.isImage %}
                                                    <a href="{{ attachment.webPath }}" target="_blank" class="attachment-image">
                                                        <img src="{{ attachment.webPath }}" alt="{{ attachment.originalFilename }}">
                                                        <span class="attachment-overlay">
                                                            <i class="bi bi-zoom-in"></i>
                                                        </span>
                                                    </a>
                                                {% else %}
                                                    <a href="{{ attachment.webPath }}" target="_blank" class="attachment-file" download>
                                                        <i class="bi {{ attachment.isPdf ? 'bi-file-pdf' : 'bi-file-earmark' }}"></i>
                                                        <span class="attachment-info">
                                                            <span class="attachment-name">{{ attachment.originalFilename }}</span>
                                                            <span class="attachment-size">{{ attachment.humanFileSize }}</span>
                                                        </span>
                                                    </a>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                {# Reply Form #}
                {% if not message.isClosed %}
                    <div class="reply-form-section">
                        <form action="{{ path('admin_contact_reply', {id: message.id}) }}" method="POST" class="reply-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('contact_reply_' ~ message.id) }}">

                            <div class="form-group">
                                <label for="reply-content" class="form-label">Votre réponse</label>
                                <textarea
                                    id="reply-content"
                                    name="content"
                                    class="form-control"
                                    rows="5"
                                    placeholder="Tapez votre réponse..."
                                    required
                                ></textarea>
                            </div>

                            <div class="reply-actions">
                                <label class="close-ticket-option">
                                    <input type="checkbox" name="close_ticket" value="1">
                                    <span>Fermer le ticket après envoi</span>
                                </label>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-send"></i>
                                    Envoyer la réponse
                                </button>
                            </div>
                        </form>
                    </div>
                {% else %}
                    <div class="ticket-closed-notice">
                        <i class="bi bi-lock-fill"></i>
                        Ce ticket est fermé. Rouvrez-le pour répondre.
                    </div>
                {% endif %}
            </div>
        </div>

        {# Sidebar #}
        <div class="contact-sidebar-column">
            {# Client Info Card #}
            <div class="sidebar-card">
                <h4 class="sidebar-card-title">
                    <i class="bi bi-person"></i>
                    Informations client
                </h4>
                <div class="info-list">
                    <div class="info-row">
                        <span class="info-label">Nom</span>
                        <span class="info-value">{{ message.fullName }}</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Email</span>
                        <span class="info-value">
                            <a href="mailto:{{ message.email }}">{{ message.email }}</a>
                        </span>
                    </div>
                    {% if message.phone %}
                        <div class="info-row">
                            <span class="info-label">Téléphone</span>
                            <span class="info-value">
                                <a href="tel:{{ message.phone }}">{{ message.phone }}</a>
                            </span>
                        </div>
                    {% endif %}
                    <div class="info-row">
                        <span class="info-label">Compte</span>
                        <span class="info-value">
                            {% if message.isMember %}
                                <span class="badge badge-success">
                                    <i class="bi bi-person-check"></i> Membre
                                </span>
                            {% else %}
                                <span class="badge badge-secondary">Visiteur</span>
                            {% endif %}
                        </span>
                    </div>
                </div>
            </div>

            {# Status Management Card #}
            <div class="sidebar-card">
                <h4 class="sidebar-card-title">
                    <i class="bi bi-flag"></i>
                    Gestion du ticket
                </h4>
                <form action="{{ path('admin_contact_status', {id: message.id}) }}" method="POST" class="status-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('contact_status_' ~ message.id) }}">
                    <div class="form-group">
                        <label class="form-label">Changer le statut</label>
                        <select name="status" class="form-select" onchange="this.form.submit()">
                            {% for status in contactStatuses %}
                                <option value="{{ status.value }}" {{ message.status == status ? 'selected' : '' }}>
                                    {{ status.label }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </form>
            </div>

            {# Order Info Card (if linked) #}
            {% if message.relatedOrder %}
                <div class="sidebar-card order-card">
                    <h4 class="sidebar-card-title">
                        <i class="bi bi-bag"></i>
                        Commande liée
                    </h4>
                    <div class="info-list">
                        <div class="info-row">
                            <span class="info-label">Numéro</span>
                            <span class="info-value">
                                <a href="{{ path('admin_order_show', {id: message.relatedOrder.id}) }}">
                                    {{ message.relatedOrder.orderNumber }}
                                </a>
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Statut</span>
                            <span class="info-value">
                                <span class="order-status-badge status-{{ message.relatedOrder.status.value }}">
                                    {{ message.relatedOrder.status.label }}
                                </span>
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Montant</span>
                            <span class="info-value">{{ message.relatedOrder.totalFormatted }}</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Date</span>
                            <span class="info-value">{{ message.relatedOrder.createdAt|date('d/m/Y') }}</span>
                        </div>
                    </div>

                    {# Change Order Status #}
                    <form action="{{ path('admin_contact_order_status', {id: message.id}) }}" method="POST" class="order-status-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('order_status_from_contact_' ~ message.id) }}">
                        <label class="form-label">Modifier le statut de la commande</label>
                        <div class="d-flex gap-2">
                            <select name="order_status" class="form-select form-select-sm">
                                {% for status in orderStatuses %}
                                    <option value="{{ status.value }}" {{ message.relatedOrder.status == status ? 'selected' : '' }}>
                                        {{ status.label }}
                                    </option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-check"></i>
                            </button>
                        </div>
                    </form>

                    <a href="{{ path('admin_order_show', {id: message.relatedOrder.id}) }}" class="btn btn-outline-secondary btn-sm w-100 mt-3">
                        <i class="bi bi-eye"></i>
                        Voir la commande
                    </a>
                </div>
            {% endif %}

            {# Product/Warranty Info (if linked) #}
            {% if message.relatedOrderItem %}
                <div class="sidebar-card warranty-card {{ message.isWarrantyValid ? 'warranty-valid' : 'warranty-expired' }}">
                    <h4 class="sidebar-card-title">
                        <i class="bi bi-shield-check"></i>
                        Produit concerné
                    </h4>
                    <div class="info-list">
                        <div class="info-row">
                            <span class="info-label">Produit</span>
                            <span class="info-value">{{ message.relatedOrderItem.productName }}</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Prix</span>
                            <span class="info-value">{{ message.relatedOrderItem.subtotalFormatted }}</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Garantie</span>
                            <span class="info-value">
                                {% if message.isWarrantyValid %}
                                    <span class="warranty-badge valid">
                                        <i class="bi bi-check-circle-fill"></i>
                                        {{ message.warrantyStatusLabel }}
                                    </span>
                                {% else %}
                                    <span class="warranty-badge expired">
                                        <i class="bi bi-x-circle-fill"></i>
                                        {{ message.warrantyStatusLabel }}
                                    </span>
                                {% endif %}
                            </span>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Admin Notes Card #}
            <div class="sidebar-card">
                <h4 class="sidebar-card-title">
                    <i class="bi bi-sticky"></i>
                    Notes internes
                </h4>
                <form action="{{ path('admin_contact_notes', {id: message.id}) }}" method="POST" class="notes-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('contact_notes_' ~ message.id) }}">
                    <textarea
                        name="notes"
                        class="form-control"
                        rows="3"
                        placeholder="Notes privées (non visibles par le client)..."
                    >{{ message.adminNotes }}</textarea>
                    <button type="submit" class="btn btn-sm btn-outline-secondary mt-2">
                        <i class="bi bi-save"></i>
                        Enregistrer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
